# Database - PostgreSQL (see repo root docker-compose.yml: `docker compose up -d`)
DATABASE_URL="postgresql://postgres:pendaftaran@127.0.0.1:15432/pendaftaran?schema=public"

# Email (SMTP) - Configure for admin notifications
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM="Sistem Pendaftaran <noreply@example.com>"
ADMIN_EMAIL=admin@example.com

# --- Authentication (WAJIB diisi di produksi) ---
# Generate: openssl rand -hex 32  (minimal 32 byte)
JWT_SECRET="ganti-dengan-secret-acak-minimal-32-karakter"
JWT_REFRESH_TTL_DAYS=7
# Origin frontend yang BOLEH mengakses API, pisahkan dengan koma.
# Contoh produksi: https://daftar-warga.desakebumen.go.id
CORS_ALLOWED_ORIGINS="http://localhost:3000"
# Rate limit global (per IP): 120 request / 60 detik
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Seed akun default (opsional) ---
# Kosongkan agar kredensial dibuat ACAK dan dicetak ke console.
# JANGAN commit nilai production ke repo.
SEED_ADMIN_EMAIL="admin@desa.id"
SEED_PETUGAS_EMAIL="petugas@desa.id"
SEED_PETUGAS_NAMA="Petugas Desa"